# Staging : copier ce fichier en .env (même dossier) et remplir chaque valeur.
# Le fichier .env ne va jamais dans Git.

# Adresse du staging, sans https://. Sans nom de domaine : l'adresse IP du serveur,
# points remplacés par des tirets, suivie de .sslip.io (ex. 141-147-10-20.sslip.io).
DOMAIN=""

# Mot de passe de la base (openssl rand -hex 24). Lettres et chiffres seulement.
POSTGRES_PASSWORD=""

# Secret des sessions (openssl rand -base64 32).
AUTH_SECRET=""

# Secret des tâches planifiées, 32 caractères au moins (openssl rand -hex 32).
TASKS_SECRET=""

# Envoi des e-mails (ex. Brevo : smtp-relay.brevo.com, port 587, identifiant et clé SMTP).
# L'adresse d'expédition doit être validée chez le fournisseur.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TimeSheet <adresse@validee.chez.le.fournisseur>"

# Toujours "false" pour un vrai test. "true" seulement avec les données de démonstration.
DEMO_PROFILES="false"

# Vide pour un vrai test. Données de démonstration : "2026-03-19T09:42:00Z".
TIMESHEET_NOW=""

# Données de démonstration seulement (comptes fictifs @exemple.com).
SEED_PASSWORD=""
