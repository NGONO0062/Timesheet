{
  "name": "timesheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && npm run lint:styles",
    "lint:styles": "node scripts/check-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:reset": "prisma migrate reset --force",
    "test:int": "vitest run --config vitest.int.config.ts",
    "plateforme:admin": "node --experimental-strip-types prisma/creer-admin-plateforme.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "boosted": "5.3.8",
    "hash-wasm": "4.12.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.0.10",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^27.0.0",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
