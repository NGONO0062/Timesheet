# Base de données (docker compose up -d db)
DATABASE_URL="postgresql://timesheet:timesheet@localhost:5432/timesheet?schema=public"

# Auth.js : générez une valeur avec `npx auth secret`
AUTH_SECRET=""

# SMTP (Mailpit en développement : interface sur http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TimeSheet <timesheet@exemple.com>"

# Adresse publique de l'application, pour les liens des e-mails.
APP_URL="http://localhost:3000"

# Secret des tâches planifiées (relance des validateurs : POST /api/taches/relances).
# 32 caractères au moins : `openssl rand -hex 32`. Vide : la route refuse tout appel.
TASKS_SECRET=""

# Bloc « Prototype uniquement : entrer avec un profil » de l'écran de connexion.
# Ne jamais activer en production.
DEMO_PROFILES="false"

# Stockage des PDF signés, hors du dossier public
STORAGE_DIR="./storage"

# Mot de passe des comptes fictifs de démonstration (npm run db:seed).
SEED_PASSWORD="Demo-TimeSheet-2026"

# Horloge de démonstration (développement seulement) : l'application se place à cette date.
# Exemple : "2026-03-19T09:42:00Z" (jeudi de la semaine 12, celle des maquettes). Vide en production.
TIMESHEET_NOW=""
